{
  "name": "billingua",
  "private": true,
  "version": "1.0.0",
  "description": "İngilizce EPUB kitapları iki dilli (İngilizce-Türkçe) EPUB ve PDF olarak çevirir.",
  "author": "hakanonel05",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node dist/server.cjs",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --external:vite --outfile=dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-electron release",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "build:electron": "vite build && esbuild electron/main.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/main.cjs",
    "electron": "npm run build:electron && electron .",
    "dist:exe": "npm run build:electron && electron-builder --win",
    "dist:mac": "npm run build:electron && electron-builder --mac"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pdfmake": "^0.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.2.3",
    "electron": "44.4.5",
    "electron-builder": "26.16.1",
    "esbuild": "^0.27.4",
    "express": "^4.21.2",
    "idb-keyval": "^6.2.2",
    "jsdom": "^26.1.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdfmake": "^0.3.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^3.2.7"
  },
  "build": {
    "appId": "com.hakanonel05.billingua",
    "productName": "Billingua",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/server.cjs",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "electron/icon.png"
    },
    "portable": {
      "artifactName": "Billingua-${version}-portable.exe"
    },
    "nsis": {
      "artifactName": "Billingua-${version}-kurulum.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Billingua"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "electron/icon.png",
      "category": "public.app-category.education",
      "identity": "-"
    },
    "dmg": {
      "artifactName": "Billingua-${version}-mac.dmg"
    }
  }
}
